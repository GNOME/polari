#. commands that would be nice to support:
#.
#. AWAY: N_("/AWAY [<message>] — sets or unsets away message"),
#. LIST: N_("/LIST [<channel>] — lists stats on <channel>, or all channels on the server"),
#. MODE: "/MODE <mode> <nick|channel> — ",
#. NOTICE: N_("/NOTICE <nick|channel> <message> — sends notice to <nick|channel>"),
#. OP: N_("/OP <nick> — gives channel operator status to <nick>"),
#.
#.
#: src/ircParser.js:34
msgid ""
"/CLOSE [<channel>] [<reason>] — closes <channel>, by default the current one"
msgstr ""
"/CLOSE [<channel>] [<reason>] — lukkar <channel>, som standard den gjeldande"

#: src/ircParser.js:35
msgid ""
"/HELP [<command>] — displays help for <command>, or a list of available "
"commands"
msgstr ""
"/HELP [<command>] — viser hjelp for <command>, eller ei liste over "
"tilgjengelege kommandoar"

#: src/ircParser.js:36
msgid ""
"/INVITE <nick> [<channel>] — invites <nick> to <channel>, or the current one"
msgstr ""
"/INVITE <nick> [<channel>] — inviterer <nick> til <channel>, eller til den "
"gjeldande"

#: src/ircParser.js:37
msgid "/JOIN <channel> — joins <channel>"
msgstr "/JOIN <channel> — går inn i <channel>"

#: src/ircParser.js:38
msgid "/KICK <nick> — kicks <nick> from current channel"
msgstr "/KICK <nick> — kastar <nick> ut av den gjeldande kanalen"

#: src/ircParser.js:39
msgid "/ME <action> — sends <action> to the current channel"
msgstr "/ME <action> — sender <action> til den gjeldande kanalen"

#: src/ircParser.js:40
msgid "/MSG <nick> [<message>] — sends a private message to <nick>"
msgstr "/MSG <nick> [<message>] — sender ei privat melding til <nick>"

#: src/ircParser.js:41
msgid "/NAMES — lists users on the current channel"
msgstr "/NAMES — listar opp brukarane i den gjeldande kanalen"

#: src/ircParser.js:42
msgid "/NICK <nickname> — sets your nick to <nickname>"
msgstr "/NICK <nickname> — set kallenamnet ditt til <nickname>"

#: src/ircParser.js:43
msgid ""
"/PART [<channel>] [<reason>] — leaves <channel>, by default the current one"
msgstr ""
"/PART [<channel>] [<reason>] — forlèt <channel>, som standard den gjeldande"

#: src/ircParser.js:44
msgid "/QUERY <nick> — opens a private conversation with <nick>"
msgstr "/QUERY <nick> — opnar ein privat samtale med <nick>"

#: src/ircParser.js:45
msgid "/QUIT [<reason>] — disconnects from the current server"
msgstr "/QUIT [<reason>] — koplar frå den gjeldande tenaren"

#: src/ircParser.js:46
msgid "/SAY <text> — sends <text> to the current room/contact"
msgstr ""
"/SAY <text> — sender <text> til det gjeldande rommet eller den gjeldande "
"kontakten"

#: src/ircParser.js:47
msgid "/TOPIC <topic> — sets the topic to <topic>, or shows the current one"
msgstr ""
"/TOPIC <topic> — set emnet til <topic>, eller viser det gjeldande emnet"

#: src/ircParser.js:48
msgid "/WHOIS <nick> — requests information on <nick>"
msgstr "/WHOIS <nick> — ber om informasjon om <nick>"

#: src/ircParser.js:51
msgid "Unknown command — try /HELP for a list of available commands"
msgstr ""
"Ukjend kommando — prøv /HELP for ei liste over tilgjengelege kommandoar"

#: src/ircParser.js:104
msgid "Known commands:"
msgstr "Kjende kommandoar:"

#: src/ircParser.js:275
msgid "No topic set"
msgstr "Inkje emne er sett"

